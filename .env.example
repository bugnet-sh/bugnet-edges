# Secrets of the edge binaries, each from the environment only. Settings live in example/*.toml.

# bugnet-edge, in /etc/bugnet/edge.env. The router's EdgeService token, at least 32 characters
# with no spaces, the same value as BUGNET_EDGE_TOKEN in the router's environment.
BUGNET_EDGE_TOKEN=
# 32 random bytes in base64url without padding, the last part of each provider's webhook URL.
# bugnet-dev keys prints one.
BUGNET_HOOK_PATH_SECRET=

# bugnet-edge --role secrets, in /etc/bugnet/secrets-route.env. The router's SecretsRouteService
# token, by the same rules.
BUGNET_SECRETS_TOKEN=

# bugnet-edge --role sessions, in /etc/bugnet/sessions.env. The router's SessionPageService
# token, by the same rules.
BUGNET_SESSIONS_TOKEN=

# bugnet-egress, in /etc/bugnet/egress.env. The router's EgressService token, at least 32
# characters with no spaces, the same value as BUGNET_EGRESS_TOKEN in the router's environment.
BUGNET_EGRESS_TOKEN=
# The router's repository fetcher token, the same value as BUGNET_EGRESS_FETCH_TOKEN in the router's
# environment. Empty turns the fetcher's entry off.
BUGNET_EGRESS_FETCH_TOKEN=

# bugnet-certs, in /etc/bugnet/certs.env. Only the variables certs.toml's dns_env lists, here
# Cloudflare's token that can edit only the zone's DNS records.
CF_DNS_API_TOKEN=

# x402-fake-seller, for settle = "self". fee_payer's key, 64 bytes in base58 or a JSON byte array,
# as bugnet-payments' keys testseller writes it. The name is fee_payer_key_env's default.
TESTSELLER_FEE_PAYER_KEY=
# x402-fake-seller's test API token. When set it opens /__test/, which lists the payloads seen.
TESTSELLER_TEST_TOKEN=
# bugnet-ssh's caller token for the router, at least 32 characters.
BUGNET_SSH_TOKEN=

# Trace backend, the whole Authorization header value, empty for a local collector. Read by
# bugnet-edge (the edge and secrets roles), bugnet-ssh and bugnet-egress, in each unit's environment.
BUGNET_OTLP_AUTHORIZATION=
