# Secrets of the edge binaries, each from the environment only. Settings live in example/*.toml.

# bugnet-edge, in /etc/bugnet/edge.env. The router's EdgeService token, at least 32 characters
# with no spaces, the same value as BUGNET_EDGE_TOKEN in the router's environment.
BUGNET_EDGE_TOKEN=
# 32 random bytes in base64url without padding, the last part of each provider's webhook URL.
# bugnet-dev keys prints one.
BUGNET_HOOK_PATH_SECRET=

# bugnet-edge --role secrets, in /etc/bugnet/secrets-route.env. The router's SecretsRouteService
# token, by the same rules.
BUGNET_SECRETS_TOKEN=

# bugnet-certs, in /etc/bugnet/certs.env. Only the variables certs.toml's dns_env lists, here
# Cloudflare's token that can edit only the zone's DNS records.
CF_DNS_API_TOKEN=
